{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "padding": {
            "top": 4,
            "left": 5,
            "right": 8
        },
        "color": {
            "1": "38;2;229;152;155" // #e5989b
        }
    },
    "display": {
        "separator": "   ",
        "color": {
            "keys": "38;2;229;152;155",
            "output": "38;2;255;255;255"
        }
    },
    "modules": [
        "break",
        "break",
        "title",
        {
            "type": "separator",
            "string": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        },
        "os",
        "kernel",
        "packages",
        "wm",
        "terminal",
        "break",
        {
            "type": "colors",
            "symbol": "rect",
            "block": {
                "range": [1, 6]
            }
        },
        {
            "type": "custom",
            "format": "\n \n \n " 
        }
    ]
}
